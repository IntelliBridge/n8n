{
  "family": "staging-buildworkforce-n8n-main",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::132880019009:role/staging-buildworkforce-n8n-main-execution-role",
  "taskRoleArn": "arn:aws:iam::132880019009:role/staging-buildworkforce-n8n-main-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "flow",
      "image": "",
      "essential": true,
      "portMappings": [{ "containerPort": 5678, "hostPort": 5678, "protocol": "tcp" }],
      "environment": [
        { "name": "DB_TYPE", "value": "postgresdb" },
        { "name": "DB_POSTGRESDB_HOST", "value": "staging-buildworkforce-rds.cunxsqwqr7rg.us-east-1.rds.amazonaws.com" },
        { "name": "DB_POSTGRESDB_PORT", "value": "5432" },
        { "name": "DB_POSTGRESDB_DATABASE", "value": "n8n" },
        { "name": "DB_POSTGRESDB_USER", "value": "n8n" },
        { "name": "DB_POSTGRESDB_POOL_SIZE", "value": "2" },
        { "name": "DB_POSTGRESDB_SSL_ENABLED", "value": "true" },
        { "name": "DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED", "value": "false" },
        { "name": "EXECUTIONS_MODE", "value": "queue" },
        { "name": "QUEUE_BULL_REDIS_PORT", "value": "6379" },
        { "name": "QUEUE_BULL_REDIS_TLS", "value": "true" },
        { "name": "QUEUE_BULL_REDIS_DNS_LOOKUP_STRATEGY", "value": "NONE" },
        { "name": "QUEUE_HEALTH_CHECK_ACTIVE", "value": "true" },
        { "name": "N8N_DEFAULT_BINARY_DATA_MODE", "value": "database" },
        { "name": "N8N_RUNNERS_MODE", "value": "external" },
        { "name": "N8N_RUNNERS_BROKER_LISTEN_ADDRESS", "value": "127.0.0.1" },
        { "name": "N8N_HOST", "value": "flow.staging.buildworkforce.ai" },
        { "name": "N8N_PROTOCOL", "value": "https" },
        { "name": "WEBHOOK_URL", "value": "https://flow.staging.buildworkforce.ai/" },
        { "name": "N8N_PROXY_HOPS", "value": "1" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "NODE_OPTIONS", "value": "--max_old_space_size=6144" },
        { "name": "GENERIC_TIMEZONE", "value": "UTC" },
        { "name": "N8N_AI_ENABLED", "value": "true" },
        { "name": "N8N_TEMPLATES_ENABLED", "value": "false" },
        { "name": "N8N_HIRING_BANNER_ENABLED", "value": "false" },
        { "name": "N8N_DIAGNOSTICS_ENABLED", "value": "false" },
        { "name": "N8N_VERSION_NOTIFICATIONS_ENABLED", "value": "false" },
        { "name": "N8N_PERSONALIZATION_ENABLED", "value": "false" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --spider -q http://localhost:5678/healthz || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 60
      },
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/staging-buildworkforce-n8n-main",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "flow"
        }
      }
    },
    {
      "name": "runners",
      "image": "",
      "essential": true,
      "portMappings": [],
      "dependsOn": [{ "containerName": "flow", "condition": "HEALTHY" }],
      "environment": [
        { "name": "N8N_RUNNERS_TASK_BROKER_URI", "value": "http://127.0.0.1:5679" }
      ],
      "secrets": [
        {
          "name": "N8N_RUNNERS_AUTH_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:132880019009:secret:staging/n8n-cNK1BS:N8N_RUNNERS_AUTH_TOKEN::"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/staging-buildworkforce-n8n-main",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "runners"
        }
      }
    }
  ],
  "tags": [
    { "key": "Project", "value": "BuildWorkforce" },
    { "key": "Environment", "value": "staging-buildworkforce" },
    { "key": "ManagedBy", "value": "GitHubActions" },
    { "key": "Name", "value": "staging-buildworkforce-n8n-main" }
  ]
}
