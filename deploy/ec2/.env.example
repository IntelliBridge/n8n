# Flow EC2 deployment env — copy to /opt/flow/.env on the instance and fill in.
# Real values live in AWS Secrets Manager (flow/n8n-encryption-key, flow/n8n-prod-env).

# Image
ECR_REGISTRY=132880019009.dkr.ecr.us-east-1.amazonaws.com
FLOW_IMAGE_TAG=2.25.7-REPLACE_GIT_SHA
N8N_VERSION=2.25.7            # must match the n8n version inside the flow image (runners sidecar)

# Database (RDS flowdb) — values verified from the live box 2026-06-12
DB_POSTGRESDB_HOST=flowdb.cunxsqwqr7rg.us-east-1.rds.amazonaws.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=flowdb
DB_POSTGRESDB_USER=workforce
DB_POSTGRESDB_PASSWORD=REPLACE_ME   # Secrets Manager: flow/n8n-prod-db-password

# Core — N8N_ENCRYPTION_KEY MUST be the key from the 1.90 instance, or every stored
# credential becomes undecryptable. Source: Secrets Manager flow/n8n-encryption-key.
N8N_ENCRYPTION_KEY=REPLACE_ME
N8N_HOST=flow.buildworkforce.ai
GENERIC_TIMEZONE=UTC   # prod runs UTC; do not change without retiming Schedule triggers

# Task runners (2.x) — generate once: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=REPLACE_ME

# OpenSearch endpoint for n8n-nodes-torqdata embedder (carried from prod env)
OPENSEARCH_HOST=REPLACE_ME
